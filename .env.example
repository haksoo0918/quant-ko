# OpenDART API 인증키 (https://opendart.fss.or.kr)
OPENDART_API_KEY=your_opendart_api_key_here

# 한국투자증권 운용 모드: REAL (실전투자) 또는 MOCK (모의투자)
KIS_MODE=REAL

# [1] 실전투자 API 계정 정보
KIS_REAL_APP_KEY=your_real_app_key_here
KIS_REAL_APP_SECRET=your_real_app_secret_here
KIS_REAL_CANO=your_real_8_digit_account_number
KIS_REAL_ACNT_PRDT_CD=01

# [2] 모의투자 API 계정 정보 (모의 계좌 개설 후 입력)
KIS_MOCK_APP_KEY=your_mock_app_key_here
KIS_MOCK_APP_SECRET=your_mock_app_secret_here
KIS_MOCK_CANO=your_mock_8_digit_account_number
KIS_MOCK_ACNT_PRDT_CD=01

# 디스코드 알림 웹훅 URL (Discord 채널 설정 -> 연동 -> 웹훅)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# 데이터베이스 저장 경로
SQLITE_DB_PATH=data/quant_ko.db
