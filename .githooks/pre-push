#!/bin/sh
# .githooks/pre-push
# main 브랜치 원격 푸시 보호 훅 (사용자 승인 시에만 통과)

remote="$1"
url="$2"

is_main_push=0

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        is_main_push=1
        break
    fi
done

if [ "$is_main_push" -eq 1 ]; then
    token_file=".git/ALLOW_MAIN_PUSH"

    # 1. 환경변수 또는 1회성 승인 토큰 파일 확인
    if [ "$ALLOW_MAIN_PUSH" = "1" ] || [ -f "$token_file" ]; then
        if [ -f "$token_file" ]; then
            rm -f "$token_file"
        fi
        echo "✅ [승인 확인] main 브랜치 푸시 승인이 확인되었습니다. 푸시를 진행합니다."
        exit 0
    fi

    # 2. 대화형 터미널(TTY)인 경우 사용자에게 즉석 확인 요청
    if [ -t 0 ] && [ -r /dev/tty ]; then
        if exec < /dev/tty 2>/dev/null; then
            echo "⚠️  [경고] main 브랜치로의 푸시가 감지되었습니다."
            read -p "사용자 승인: 정말 main 브랜치로 푸시하시겠습니까? (yes/N): " answer
            case "$answer" in
                [Yy][Ee][Ss])
                    echo "✅ [사용자 승인] main 브랜치 푸시를 진행합니다."
                    exit 0
                    ;;
                *)
                    echo "❌ [푸시 차단] 사용자가 푸시를 승인하지 않았습니다."
                    exit 1
                    ;;
            esac
        fi
    fi

    # 3. 비대화형 환경이거나 TTY가 없을 때 승인 플래그가 없으면 차단
    echo "❌ [푸시 차단] main 브랜치 푸시는 사용자의 명시적 승인이 필요합니다."
    echo "💡 승인 방법:"
    echo "   1) 1회성 토큰 발급: New-Item .git/ALLOW_MAIN_PUSH (PowerShell) 또는 touch .git/ALLOW_MAIN_PUSH (Bash)"
    echo "   2) 환경변수 설정:   \$env:ALLOW_MAIN_PUSH=\"1\" (PowerShell) 또는 ALLOW_MAIN_PUSH=1 (Bash)"
    exit 1
fi

exit 0
