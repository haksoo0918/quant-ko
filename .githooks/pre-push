#!/bin/sh
# .githooks/pre-push
# 1. dev 브랜치 푸시 원천 차단 (dev는 로컬 전용)
# 2. main 브랜치 푸시는 사용자의 명시적 승인 시에만 허용

remote="$1"
url="$2"

while read local_ref local_oid remote_ref remote_oid; do
    # 1. dev 브랜치 푸시 시도 감지 시 무조건 차단
    if [ "$remote_ref" = "refs/heads/dev" ] || [ "$local_ref" = "refs/heads/dev" ]; then
        echo "❌ [dev 푸시 차단] dev 브랜치는 로컬 전용 브랜치입니다."
        echo "   dev 브랜치는 원격(origin/dev)으로 푸시할 수 없습니다."
        echo "   main 브랜치로 머지 후 main만 원격에 푸시/동기화하십시오."
        exit 1
    fi

    # 2. main 브랜치 푸시 시 사용자 승인 확인
    if [ "$remote_ref" = "refs/heads/main" ]; then
        token_main=".git/ALLOW_MAIN_PUSH"
        if [ "$ALLOW_MAIN_PUSH" = "1" ] || [ -f "$token_main" ]; then
            rm -f "$token_main" 2>/dev/null
            echo "✅ [사용자 승인 확인] main 브랜치 푸시 승인이 확인되었습니다."
            continue
        fi

        # 대화형 TTY 확인
        if [ -t 0 ] && [ -r /dev/tty ]; then
            if exec < /dev/tty 2>/dev/null; then
                echo "⚠️  [경고] main 브랜치를 원격(origin/main)으로 푸시하려고 합니다."
                read -p "사용자 승인: 정말 main 브랜치를 푸시하시겠습니까? (yes/N): " answer
                case "$answer" in
                    [Yy][Ee][Ss])
                        echo "✅ [사용자 승인] 푸시를 진행합니다."
                        continue
                        ;;
                    *)
                        echo "❌ [푸시 차단] 사용자가 main 푸시를 승인하지 않았습니다."
                        exit 1
                        ;;
                esac
            fi
        fi

        echo "❌ [main 푸시 차단] main 브랜치 원격 푸시는 사용자의 명시적 승인이 있어야 합니다."
        echo "💡 AI 에이전트는 토큰 파일을 임의 생성할 수 없습니다. 사용자가 직접 승인해야 합니다."
        echo "   사용자 직접 승인: \$env:ALLOW_MAIN_PUSH=\"1\" (PowerShell) 또는 New-Item .git/ALLOW_MAIN_PUSH"
        exit 1
    fi
done

exit 0
