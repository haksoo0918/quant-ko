#!/bin/sh
# .githooks/pre-merge-commit
# main 브랜치 머지 커밋 보호 훅 (사용자 승인 시에만 통과)

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# main 브랜치 머지 커밋인 경우 강력 차단 및 사용자 승인 검사
if [ "$current_branch" = "main" ]; then
    token_main=".git/ALLOW_MAIN_MERGE"
    
    if [ "$ALLOW_MAIN_MERGE" = "1" ] || [ -f "$token_main" ]; then
        rm -f "$token_main" 2>/dev/null
        echo "✅ [사용자 승인 확인] main 머지 승인이 확인되었습니다. 머지 커밋을 진행합니다."
        exit 0
    fi

    # 대화형 터미널(TTY)인 경우 사용자에게 즉석 확인 요청
    if [ -t 0 ] && [ -r /dev/tty ]; then
        if exec < /dev/tty 2>/dev/null; then
            echo "⚠️  [경고] main 브랜치로의 머지 커밋이 감지되었습니다."
            read -p "사용자 승인: 정말 main 머지를 진행하시겠습니까? (yes/N): " answer
            case "$answer" in
                [Yy][Ee][Ss])
                    echo "✅ [사용자 승인] 머지를 진행합니다."
                    exit 0
                    ;;
                *)
                    echo "❌ [머지 차단] 사용자가 main 머지를 승인하지 않았습니다."
                    exit 1
                    ;;
            esac
        fi
    fi

    echo "❌ [main 머지 차단] main 브랜치 머지는 사용자의 명시적 승인이 있어야만 가능합니다."
    echo "💡 AI 에이전트는 토큰 파일을 임의 생성할 수 없습니다. 사용자가 직접 승인해야 합니다."
    echo "   사용자 직접 승인: \$env:ALLOW_MAIN_MERGE=\"1\" (PowerShell) 또는 New-Item .git/ALLOW_MAIN_MERGE"
    exit 1
fi

exit 0
